# Copy to `.env.toml` in the directory you launch `sentinel-node` from.
# Every key can also be set as an environment variable named
# SENTINEL__<KEY_IN_UPPERCASE>. The environment wins over this file.

node_id        = 1
api_bind_addr  = "127.0.0.1:8443"
storage_path   = "data/node1.sled"

tls_cert_path  = "pki/node1.crt"
tls_key_path   = "pki/node1.key"
ca_cert_path   = "pki/ca.crt"

# Key holders needed to unseal this node ("2" = a 2-of-N quorum). Must match
# the threshold the key shares were created with. Minimum 2.
unseal_threshold = 2

# Where Raft keeps its term, vote and log (fsync'd; must be durable storage).
# Default: "<storage_path>.raft". Never delete this without also deleting
# storage_path, or the reverse; the two are a matched pair.
# raft_dir = "data/node1.raft"

# How long a write waits for a majority of the cluster to commit it (ms).
commit_timeout_ms = 5000

# ---- Authorization (default-deny; the node refuses to start without a usable policy) ----
# Identities are certificate Common Names. Roles are separate on purpose:
#   peer_cns   - the other cluster nodes; may call /raft/* and nothing else
#   admin_cns  - may seal/unseal (/sys/*); cannot read secrets
#   writer_cns - may write/delete and read secrets
#   reader_cns - may read/list secrets and view the dashboard
# A node certificate may not also appear in the other lists.
# From the environment: SENTINEL__ADMIN_CNS="root,deputy" (comma-separated).
admin_cns  = ["alice-admin"]
writer_cns = ["app-writer"]
reader_cns = ["app-reader"]
# peer_cns = ["node1", "node2", "node3"]   # required whenever `peers` is set

# Certificates to refuse even though the CA signed them: hex serial numbers
# (`openssl x509 -noout -serial -in client.crt`). A deny-list checked after the
# TLS handshake, not CRL/OCSP; editing it needs a restart.
# revoked_serials = ["0F95E68032C3D262C044FF3A0228C944CB3B642E"]

# DEVELOPMENT ONLY. Lets any client with a valid certificate do anything,
# including cluster RPCs. Logs a warning at startup. Never enable in production.
# insecure_allow_any_client = false

# Other nodes, "<node_id>=<base_url>". Leave empty for a single node.
# From the environment: SENTINEL__PEERS="2=https://127.0.0.1:8444,3=https://127.0.0.1:8445"
peers = [
    # "2=https://127.0.0.1:8444",
    # "3=https://127.0.0.1:8445",
]